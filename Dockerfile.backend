# FastAPI backend — Python 3.11 slim image
# Serves static files + /api/chat endpoint with RAG
FROM python:3.11-slim

WORKDIR /app

# Install Python dependencies first (cached layer)
COPY requirements.txt ./
RUN pip install --no-cache-dir fastapi "uvicorn[standard]" httpx scikit-learn numpy python-dotenv

# Copy application code
COPY backend/ ./backend/
COPY knowledge/ ./knowledge/

# Copy all static frontend files
COPY index.html app.js style.css chat.js ou.ico ./

EXPOSE 3000

CMD ["uvicorn", "backend.app:app", "--host", "0.0.0.0", "--port", "3000"]
